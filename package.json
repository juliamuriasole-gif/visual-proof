{
  "name": "visual-proof",
  "version": "0.1.0",
  "private": true,
  "description": "Visual proof of a change: screenshot routes before/after, pixel-diff them, and write one HTML report.",
  "type": "module",
  "bin": {
    "visual-proof": "bin/visual-proof.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "test": "node --test test/",
    "demo": "node scripts/demo.js",
    "demo:expected": "node scripts/demo.js --config examples/routes.expected-change.json",
    "install-browsers": "playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0"
  }
}
